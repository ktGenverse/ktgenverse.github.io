{"24":[[[1,"日本書紀 巻第四 孝霊天皇","妃倭國香媛亦名絚某姉、生倭迹々日百襲姬命・彥五十狹芹彥命亦名吉備津彥命・倭迹々稚屋姬命。","https://seisaku.bz/nihonshoki/shoki_04.html#:~:text=%E5%BD%A5%E4%BA%94%E5%8D%81%E7%8B%B9%E8%8A%B9%E5%BD%A5%E5%91%BD%E4%BA%A6%E5%90%8D%E5%90%89%E5%82%99%E6%B4%A5%E5%BD%A5%E5%91%BD"],[1,"古事記 中巻 孝霊天皇","又娶意富夜麻登玖邇阿禮比賣命、生御子、夜麻登登母母曾毘賣命、次日子刺肩別命、次比古伊佐勢理毘古命・亦名大吉備津日子命、次倭飛羽矢若屋比賣。四柱。","https://seisaku.bz/kojiki/kojiki_08.html#:~:text=%E5%8F%88%E5%A8%B6%E6%84%8F%E5%AF%8C%E5%A4%9C%E9%BA%BB%E7%99%BB%E7%8E%96%E9%82%87%E9%98%BF%E7%A6%AE%E6%AF%94%E8%B3%A3%E5%91%BD"],[1,"古事記 中巻 孝霊天皇","又娶其阿禮比賣命之弟・蠅伊呂杼、生御子、日子寤間命、次若日子建吉備津日子命。二柱。","https://seisaku.bz/kojiki/kojiki_08.html#:~:text=%E6%AC%A1%E8%8B%A5%E6%97%A5%E5%AD%90%E5%BB%BA%E5%90%89%E5%82%99%E6%B4%A5%E6%97%A5%E5%AD%90%E5%91%BD"]],"吉備津彦命",1,"孝霊天皇"],"56":[[[1,"日本書紀 巻第六 垂仁天皇","妃渟葉田瓊入媛、生鐸石別命與膽香足姬命。","https://seisaku.bz/nihonshoki/shoki_06.html#:~:text=%E7%94%9F%E9%90%B8%E7%9F%B3%E5%88%A5%E5%91%BD%E8%88%87%E8%86%BD%E9%A6%99%E8%B6%B3%E5%A7%AC%E5%91%BD"]],"渟葉田瓊入媛",0,"垂仁天皇"],"88":[[[1,"日本書紀 巻第七 景行天皇","次妃阿倍氏木事之女高田媛、生武國凝別皇子、是伊豫國御村別之始祖也。","https://seisaku.bz/nihonshoki/shoki_07.html#:~:text=%E6%AC%A1%E5%A6%83%E9%98%BF%E5%80%8D%E6%B0%8F%E6%9C%A8%E4%BA%8B%E4%B9%8B%E5%A5%B3%E9%AB%98%E7%94%B0%E5%AA%9B"]],"高田媛",0,"景行天皇"],"120":[[[1,"古事記 中巻 成務天皇","此天皇、娶穗積臣等之祖建忍山垂根之女・名弟財郎女、生御子、和訶奴氣王。一柱。","https://seisaku.bz/kojiki/kojiki_11.html#:~:text=%E5%A8%B6%E7%A9%97%E7%A9%8D%E8%87%A3%E7%AD%89%E4%B9%8B%E7%A5%96%E5%BB%BA%E5%BF%8D%E5%B1%B1%E5%9E%82%E6%A0%B9%E4%B9%8B%E5%A5%B3"]],"弟財郎女",0,"成務天皇"],"152":[[[1,"日本書紀 巻第十 応神天皇","又妃皇后弟々姬、生阿倍皇女・淡路御原皇女・紀之菟野皇女。","https://seisaku.bz/nihonshoki/shoki_10.html#:~:text=%E5%8F%88%E5%A6%83%E7%9A%87%E5%90%8E%E5%BC%9F%E3%80%85%E5%A7%AC"]],"阿倍皇女",0,"応神天皇"],"184":[[[1,"古事記 中巻 応神天皇","又娶迦具漏比賣、生御子、川原田郎女、次玉郎女、次忍坂大中比賣、次登富志郎女、次迦多遲王。五柱。","https://seisaku.bz/kojiki/kojiki_13.html#:~:text=%E5%8F%88%E5%A8%B6%E8%BF%A6%E5%85%B7%E6%BC%8F%E6%AF%94%E8%B3%A3"]],"迦多遅王",0,"応神天皇"],"216":[[[1,"日本書紀 巻第十五 清寧天皇","白髮武廣國押稚日本根子天皇、大泊瀬幼武天皇第三子也、母曰葛城韓媛。","https://seisaku.bz/nihonshoki/shoki_15.html#:~:text=%E7%99%BD%E9%AB%AE%E6%AD%A6%E5%BB%A3%E5%9C%8B%E6%8A%BC%E7%A8%9A%E6%97%A5%E6%9C%AC%E6%A0%B9%E5%AD%90%E5%A4%A9%E7%9A%87"]],"葛城韓媛",0,"雄略天皇"],"248":[[[1,"日本書紀 巻第八 仲哀天皇","足仲彥天皇、日本武尊第二子也。","https://seisaku.bz/nihonshoki/shoki_08.html#:~:text=%E6%97%A5%E6%9C%AC%E6%AD%A6%E5%B0%8A%E7%AC%AC%E4%BA%8C%E5%AD%90%E4%B9%9F"],[1,"日本書紀 巻第八 仲哀天皇","母皇后曰兩道入姬命、活目入彥五十狹茅天皇之女也。","https://seisaku.bz/nihonshoki/shoki_08.html#:~:text=%E6%B4%BB%E7%9B%AE%E5%85%A5%E5%BD%A5%E4%BA%94%E5%8D%81%E7%8B%B9%E8%8C%85%E5%A4%A9%E7%9A%87%E4%B9%8B%E5%A5%B3%E4%B9%9F"],[1,"日本書紀 巻第八 仲哀天皇","先是、娶叔父彥人大兄之女大中姬爲妃、生麛坂皇子・忍熊皇子。","https://seisaku.bz/nihonshoki/shoki_08.html#:~:text=%E5%A8%B6%E5%8F%94%E7%88%B6%E5%BD%A5%E4%BA%BA%E5%A4%A7%E5%85%84%E4%B9%8B%E5%A5%B3%E5%A4%A7%E4%B8%AD%E5%A7%AC%E7%88%B2%E5%A6%83"],[1,"日本書紀 巻第八 仲哀天皇","次娶來熊田造祖大酒主之女弟媛、生譽屋別皇子。","https://seisaku.bz/nihonshoki/shoki_08.html#:~:text=%E6%AC%A1%E5%A8%B6%E4%BE%86%E7%86%8A%E7%94%B0%E9%80%A0%E7%A5%96%E5%A4%A7%E9%85%92%E4%B8%BB%E4%B9%8B%E5%A5%B3%E5%BC%9F%E5%AA%9B"],[1,"古事記 中巻 仲哀天皇","此天皇、娶大江王之女・大中津比賣命、生御子、香坂王、忍熊王。二柱。","https://seisaku.bz/kojiki/kojiki_12.html#:~:text=%E5%A8%B6%E5%A4%A7%E6%B1%9F%E7%8E%8B%E4%B9%8B%E5%A5%B3"],[1,"古事記 中巻 仲哀天皇","又娶息長帶比賣命是大后生御子、品夜和氣命、次大鞆和氣命・亦名品陀和氣命。二柱。","https://seisaku.bz/kojiki/kojiki_12.html#:~:text=%E5%8F%88%E5%A8%B6%E6%81%AF%E9%95%B7%E5%B8%B6%E6%AF%94%E8%B3%A3%E5%91%BD%E6%98%AF%E5%A4%A7%E5%90%8E%E7%94%9F%E5%BE%A1%E5%AD%90"]],"仲哀天皇",1,""],"312":[[[1,"日本書紀 巻第十七 継体天皇","次、和珥臣河內女曰荑媛、生一男二女、其一曰稚綾姬皇女、其二曰圓娘皇女、其三曰厚皇子。","https://seisaku.bz/nihonshoki/shoki_17.html#:~:text=%E5%92%8C%E7%8F%A5%E8%87%A3%E6%B2%B3%E5%85%A7%E5%A5%B3%E6%9B%B0%E8%8D%91%E5%AA%9B"]],"厚皇子",0,"継体天皇"],"344":[[[1,"日本書紀 巻第二十一 崇峻天皇","泊瀬部天皇、天國排開廣庭天皇第十二子也、母曰小姉君。","https://seisaku.bz/nihonshoki/shoki_21.html#:~:text=%E5%A4%A9%E5%9C%8B%E6%8E%92%E9%96%8B%E5%BB%A3%E5%BA%AD%E5%A4%A9%E7%9A%87%E7%AC%AC%E5%8D%81%E4%BA%8C%E5%AD%90%E4%B9%9F"],[1,"古事記 下巻 欽明天皇","又娶岐多志比賣命之姨・小兄比賣、生御子、馬木王、次葛城王、次間人穴太部王、次三枝部穴太部王、亦名須賣伊呂杼、次長谷部若雀命。五柱。","https://seisaku.bz/kojiki/kojiki_17.html#:~:text=%E5%8F%88%E5%A8%B6%E5%B2%90%E5%A4%9A%E5%BF%97%E6%AF%94%E8%B3%A3%E5%91%BD%E4%B9%8B%E5%A7%A8"]],"小姉君",1,"欽明天皇"],"376":[[[1,"日本書紀 巻第二十 敏達天皇","其二曰竹田皇子、其三曰小墾田皇女、是嫁於彥人大兄皇子、其四曰鸕鷀守皇女更名、輕守皇女、其五曰尾張皇子、其六曰田眼皇女、是嫁於息長足日廣額天皇、其七曰櫻井弓張皇女。","https://seisaku.bz/nihonshoki/shoki_20.html#:~:text=%E6%98%AF%E5%AB%81%E6%96%BC%E6%81%AF%E9%95%B7%E8%B6%B3%E6%97%A5%E5%BB%A3%E9%A1%8D%E5%A4%A9%E7%9A%87"]],"田眼皇女",0,"敏達天皇"],"408":[[[1,"日本書紀 巻第二十三 舒明天皇","夫人蘇我嶋大臣女法提郎媛、生古人皇子更名大兄皇子。","https://seisaku.bz/nihonshoki/shoki_23.html#:~:text=%E5%A4%AB%E4%BA%BA%E8%98%87%E6%88%91%E5%B6%8B%E5%A4%A7%E8%87%A3%E5%A5%B3%E6%B3%95%E6%8F%90%E9%83%8E%E5%AA%9B"],[1,"日本書紀 巻第二十七 天智天皇","立古人大兄皇子女倭姬王、爲皇后。","https://seisaku.bz/nihonshoki/shoki_27.html#:~:text=%E7%AB%8B%E5%8F%A4%E4%BA%BA%E5%A4%A7%E5%85%84%E7%9A%87%E5%AD%90%E5%A5%B3%E5%80%AD%E5%A7%AC%E7%8E%8B"]],"古人大兄皇子",1,"舒明天皇"],"440":[[[1,"日本書紀 巻第二十九 天武天皇","天皇初娶鏡王女額田姬王、生十市皇女。","https://seisaku.bz/nihonshoki/shoki_29.html#:~:text=%E5%A4%A9%E7%9A%87%E5%88%9D%E5%A8%B6%E9%8F%A1%E7%8E%8B%E5%A5%B3%E9%A1%8D%E7%94%B0%E5%A7%AC%E7%8E%8B"]],"額田王",1,"天武天皇"],"472":[[[2,"続日本紀 巻第一 文武天皇","以藤原朝臣宮子娘爲夫人。紀朝臣竃門娘。石川朝臣刀子娘爲妃。","https://zh.wikisource.org/wiki/續日本紀/卷第一#:~:text=%E4%BB%A5%E8%97%A4%E5%8E%9F%E6%9C%9D%E8%87%A3%E5%AE%AE%E5%AD%90%E5%A8%98%E7%88%B2%E5%A4%AB%E4%BA%BA"]],"石川刀子娘",0,"文武天皇"],"504":[[],"市原王",0,""],"536":[[],"大焦別命",0,"景行天皇"],"568":[[],"橘嘉智子",0,"嵯峨天皇"],"600":[[],"業良親王",0,"嵯峨天皇"],"632":[[],"源容姫",0,"嵯峨天皇"],"664":[[],"宇多天皇",1,""],"696":[[],"藤原和香子",0,"醍醐天皇"],"728":[[],"式明親王",0,"醍醐天皇"],"760":[[],"藤原正妃",0,"村上天皇"],"792":[[],"永平親王",0,"村上天皇"],"824":[[],"媄子内親王",0,"一条天皇"],"856":[[],"正子内親王",0,"後朱雀天皇"],"888":[[],"懐子内親王",0,"堀河天皇"],"920":[[],"暲子内親王",0,"鳥羽天皇"],"952":[[],"僐子内親王",0,"二条天皇"],"984":[[],"覚仁法親王",0,"後鳥羽天皇"],"1016":[[],"忠成王",0,"順徳天皇"],"1048":[[],"昱子内親王",0,"後堀河天皇"],"1080":[[],"帥典侍",0,"亀山天皇"],"1112":[[],"行円法親王",0,"亀山天皇"],"1144":[[],"寛性入道親王",0,"伏見天皇"],"1176":[[],"権中納言局",0,"後醍醐天皇"],"1208":[[],"懐良親王",0,"後醍醐天皇"],"1240":[[],"大蔵卿局",0,"後村上天皇"],"1272":[[],"覚増法親王",0,"後光厳天皇"],"1304":[[],"大炊御門信子",0,