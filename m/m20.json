{"20":[[[1,"日本書紀 巻第四 孝霊天皇","亦妃絚某弟、生彥狹嶋命・稚武彥命。","https://seisaku.bz/nihonshoki/shoki_04.html#:~:text=%E4%BA%A6%E5%A6%83%E7%B5%9A%E6%9F%90%E5%BC%9F"],[1,"古事記 中巻 孝霊天皇","又娶其阿禮比賣命之弟・蠅伊呂杼、生御子、日子寤間命、次若日子建吉備津日子命。二柱。","https://seisaku.bz/kojiki/kojiki_08.html#:~:text=%E6%AC%A1%E8%8B%A5%E6%97%A5%E5%AD%90%E5%BB%BA%E5%90%89%E5%82%99%E6%B4%A5%E6%97%A5%E5%AD%90%E5%91%BD"]],"稚武彦命",1,"孝霊天皇"],"52":[[[1,"日本書紀 巻第五 崇神天皇","又妃、紀伊國荒河戸畔女遠津年魚眼眼妙媛一云、大海宿禰女八坂振天某邊、生豐城入彥命・豐鍬入姬命。","https://seisaku.bz/nihonshoki/shoki_05.html#:~:text=%E5%9C%8B%E8%8D%92%E6%B2%B3%E6%88%B8%E7%95%94%E5%A5%B3%E9%81%A0%E6%B4%A5%E5%B9%B4%E9%AD%9A%E7%9C%BC%E7%9C%BC%E5%A6%99%E5%AA%9B%E4%B8%80%E4%BA%91"],[1,"古事記 中巻 崇神天皇","此天皇、娶木國造・名荒河刀辨之女刀辨二字以音遠津年魚目目微比賣、生御子、豐木入日子命、次豐鉏入日賣命。二柱。","https://seisaku.bz/kojiki/kojiki_09.html#:~:text=%E9%81%A0%E6%B4%A5%E5%B9%B4%E9%AD%9A%E7%9B%AE%E7%9B%AE%E5%BE%AE%E6%AF%94%E8%B3%A3"]],"豊鍬入姫命",1,"崇神天皇"],"84":[[[1,"日本書紀 巻第七 景行天皇","又妃三尾氏磐城別之妹水齒郎媛、生五百野皇女。","https://seisaku.bz/nihonshoki/shoki_07.html#:~:text=%E5%8F%88%E5%A6%83%E4%B8%89%E5%B0%BE%E6%B0%8F%E7%A3%90%E5%9F%8E%E5%88%A5%E4%B9%8B%E5%A6%B9%E6%B0%B4%E9%BD%92%E9%83%8E%E5%AA%9B"]],"五百野皇女",0,"景行天皇"],"116":[[],"五十狭城入彦皇子",0,"景行天皇"],"148":[[[1,"日本書紀 巻第十 応神天皇","先是、天皇以皇后姉高城入姬爲妃、生額田大中彥皇子・大山守皇子・去來眞稚皇子・大原皇女・澇來田皇女。","https://seisaku.bz/nihonshoki/shoki_10.html#:~:text=%E5%A4%A9%E7%9A%87%E4%BB%A5%E7%9A%87%E5%90%8E%E5%A7%89%E9%AB%98%E5%9F%8E%E5%85%A5%E5%A7%AC%E7%88%B2%E5%A6%83"],[1,"日本書紀 巻第十 応神天皇","去來眞稚皇子、是深河別之始祖也。","https://seisaku.bz/nihonshoki/shoki_10.html#:~:text=%E6%98%AF%E6%B7%B1%E6%B2%B3%E5%88%A5%E4%B9%8B%E5%A7%8B%E7%A5%96%E4%B9%9F"]],"去来真稚皇子",0,"応神天皇"],"180":[[[1,"古事記 中巻 応神天皇","又娶迦具漏比賣、生御子、川原田郎女、次玉郎女、次忍坂大中比賣、次登富志郎女、次迦多遲王。五柱。","https://seisaku.bz/kojiki/kojiki_13.html#:~:text=%E5%8F%88%E5%A8%B6%E8%BF%A6%E5%85%B7%E6%BC%8F%E6%AF%94%E8%B3%A3"]],"川原田郎女",0,"応神天皇"],"212":[[[1,"日本書紀 巻第十三 允恭天皇","皇后生木梨輕皇子・名形大娘皇女・境黑彥皇子・穴穗天皇・輕大娘皇女・八釣白彥皇子・大泊瀬稚武天皇・但馬橘大娘皇女・酒見皇女。","https://seisaku.bz/nihonshoki/shoki_13.html#:~:text=%E7%9A%87%E5%90%8E%E7%94%9F%E6%9C%A8%E6%A2%A8%E8%BC