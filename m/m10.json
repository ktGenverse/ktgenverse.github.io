{"10":[[[1,"日本書紀 巻第四 懿徳天皇","一云、天皇母弟武石彥奇友背命。","https://seisaku.bz/nihonshoki/shoki_04.html#:~:text=%E5%A4%A9%E7%9A%87%E6%AF%8D%E5%BC%9F%E6%AD%A6%E7%9F%B3%E5%BD%A5%E5%A5%87%E5%8F%8B%E8%83%8C%E5%91%BD"]],"武石彦奇友背命",0,"懿徳天皇"],"42":[[],"武渟川別",0,"孝元天皇"],"74":[[],"狭穂姫命",1,"垂仁天皇"],"106":[[[1,"古事記 中巻 景行天皇","生御子、櫛角別王、次大碓命、次小碓命・亦名倭男具那命具那二字以音、次倭根子命、次神櫛王。五柱。","https://seisaku.bz/kojiki/kojiki_11.html#:~:text=%E4%BA%A6%E5%90%8D%E5%80%AD%E7%94%B7%E5%85%B7%E9%82%A3%E5%91%BD"]],"櫛角別王",0,"景行天皇"],"138":[[[1,"日本書紀 巻第九 神功皇后","氣長足姬尊、稚日本根子彥大日々天皇之曾孫、氣長宿禰王之女也、母曰葛城高顙媛。","https://seisaku.bz/nihonshoki/shoki_09.html#:~:text=%E7%A8%9A%E6%97%A5%E6%9C%AC%E6%A0%B9%E5%AD%90%E5%BD%A5%E5%A4%A7%E6%97%A5%E3%80%85%E5%A4%A9%E7%9A%87%E4%B9%8B%E6%9B%BE%E5%AD%AB"]],"葛城高顙媛",0,""],"170":[[],"尾綱根命",0,""],"202":[[[1,"日本書紀 巻第十二 反正天皇","又、納夫人弟々媛、生財皇女與高部皇子。","https://seisaku.bz/nihonshoki/shoki_12.html#:~:text=%E7%94%9F%E8%B2%A1%E7%9A%87%E5%A5%B3%E8%88%87%E9%AB%98%E9%83%A8%E7%9A%87%E5%AD%90"]],"高部皇子",0,"反正天皇"],"234":[[],"意富富杼王",0,"応神天皇"],"266":[[[1,"日本書紀 巻第五 崇神天皇","二月辛亥朔丙寅、立御間城姬爲皇后。先是、后生活目入彥五十狹茅天皇・彥五十狹茅命・國方姬命・千々衝倭姬命・倭彥命・五十日鶴彥命。","https://seisaku.bz/nihonshoki/shoki_05.html#:~:text=%E5%90%8E%E7%94%9F%E6%B4%BB%E7%9B%AE%E5%85%A5%E5%BD%A5%E4%BA%94%E5%8D%81%E7%8B%B9%E8%8C%85%E5%A4%A9%E7%9A%87"],[1,"日本書紀 巻第六 垂仁天皇","母皇后曰御間城姬、大彥命之女也。","https://seisaku.bz/nihonshoki/shoki_06.html#:~:text=%E6%AF%8D%E7%9A%87%E5%90%8E%E6%9B%B0%E5%BE%A1%E9%96%93%E5%9F%8E%E5%A7%AC"],[1,"古事記 中巻 開化天皇","又娶庶母・伊迦賀色許賣命、生御子、御眞木入日子印惠命印惠二字以音、次御眞津比賣命。二柱。","https://seisaku.bz/kojiki/kojiki_08.html#:~:text=%E5%BE%A1%E7%9C%9E%E6%9C%A8%E5%85%A5%E6%97%A5%E5%AD%90%E5%8D%B0%E6%83%A0%E5%91%BD"],[1,"古事記 中巻 崇神天皇","又娶大毘古命之女・御眞津比賣命、生御子、伊玖米入日子伊沙知命伊玖米伊沙知六字以音、次伊邪能眞若命自伊至能以音、次國片比賣命、次千千都久和此三字以音比賣命、次伊賀比賣命、次倭日子命。六柱。","https://seisaku.bz/kojiki/kojiki_09.html#:~:text=%E4%BC%8A%E7%8E%96%E7%B1%B3%E5%85%A5%E6%97%A5%E5%AD%90%E4%BC%8A%E6%B2%99%E7%9F%A5%E5%91%BD%E4%BC%8A%E7%8E%96%E7%B1%B3%E4%BC%8A"]],"御間城姫",1,"崇神天皇"],"298":[[[1,"日本書紀 巻第十七 継体天皇","次、坂田大跨王女曰廣媛、生三女、長曰神前皇女、仲曰茨田皇女、少曰馬來田皇女