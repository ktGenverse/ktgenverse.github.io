{"21":[[[1,"日本書紀 巻第四 孝霊天皇","一云、十市縣主等祖女眞舌媛也。","https://seisaku.bz/nihonshoki/shoki_04.html#:~:text=%E5%8D%81%E5%B8%82%E7%B8%A3%E4%B8%BB%E7%AD%89%E7%A5%96%E5%A5%B3%E7%9C%9E%E8%88%8C%E5%AA%9B%E4%B9%9F"]],"真舌姫",0,"孝霊天皇"],"53":[[[1,"日本書紀 巻第五 崇神天皇","次妃尾張大海媛、生八坂入彥命・淳名城入姬命・十市瓊入姬命。","https://seisaku.bz/nihonshoki/shoki_05.html#:~:text=%E6%AC%A1%E5%A6%83%E5%B0%BE%E5%BC%B5%E5%A4%A7%E6%B5%B7%E5%AA%9B"],[1,"古事記 中巻 崇神天皇","又娶尾張連之祖・意富阿麻比賣、生御子、大入杵命、次八坂之入日子命、次沼名木之入日賣命、次十市之入日賣命。四柱。","https://seisaku.bz/kojiki/kojiki_09.html#:~:text=%E6%AC%A1%E6%B2%BC%E5%90%8D%E6%9C%A8%E4%B9%8B%E5%85%A5%E6%97%A5%E8%B3%A3%E5%91%BD"]],"尾張大海媛",1,"崇神天皇"],"85":[[[1,"日本書紀 巻第七 景行天皇","次妃五十河媛、生神櫛皇子・稻背入彥皇子、其兄神櫛皇子、是讚岐國造之始祖也、弟稻背入彥皇子、是播磨別之始祖也。","https://seisaku.bz/nihonshoki/shoki_07.html#:~:text=%E6%98%AF%E8%AE%9A%E5%B2%90%E5%9C%8B%E9%80%A0%E4%B9%8B%E5%A7%8B%E7%A5%96%E4%B9%9F"]],"五十河媛",0,"景行天皇"],"117":[[[1,"日本書紀 巻第七 景行天皇","第七曰渟名城皇女、第八曰五百城入姬皇女、第九曰麛依姬皇女、第十曰五十狹城入彥皇子、第十一曰吉備兄彥皇子、第十二曰高城入姬皇女、第十三曰弟姬皇女。","https://seisaku.bz/nihonshoki/shoki_07.html#:~:text=%E7%AC%AC%E5%8D%81%E6%9B%B0%E4%BA%94%E5%8D%81%E7%8B%B9%E5%9F%8E%E5%85%A5%E5%BD%A5%E7%9A%87%E5%AD%90"]],"吉備兄彦皇子",0,"景行天皇"],"149":[[[1,"日本書紀 巻第十 応神天皇","先是、天皇以皇后姉高城入姬爲妃、生額田大中彥皇子・大山守皇子・去來眞稚皇子・大原皇女・澇來田皇女。","https://seisaku.bz/nihonshoki/shoki_10.html#:~:text=%E5%A4%A9%E7%9A%87%E4%BB%A5%E7%9A%87%E5%90%8E%E5%A7%89%E9%AB%98%E5%9F%8E%E5%85%A5%E5%A7%AC%E7%88%B2%E5%A6%83"],[1,"古事記 中巻 応神天皇","故、高木之入日賣之子、額田大中日子命、次大山守命、次伊奢之眞若命伊奢二字以音、次妹大原郎女、次高目郎女。五柱。","https://seisaku.bz/kojiki/kojiki_13.html#:~:text=%E9%AB%98%E6%9C%A8%E4%B9%8B%E5%85%A5%E6%97%A5%E8%B3%A3%E4%B9%8B%E5%AD%90"]],"大原皇女",0,"応神天皇"],"181":[[[1,"古事記 中巻 応神天皇","又娶迦具漏比賣、生御子、川原田郎女、次玉郎女、次忍坂大中比賣、次登富志郎女、次迦多遲王。五柱。","https://seisaku.bz/kojiki/kojiki_13.html#:~:text=%E5%8F%88%E5%A8%B6%E8%BF%A6%E5%85%B7%E6%BC%8F%E6%AF%94%E8%B3%A3"]],"玉郎女",0,"応神天皇"],"213":[[[1,"日本書紀 巻第十三 允恭天皇","皇后生木梨輕皇子・名形大娘皇女・境黑彥皇子・穴穗天皇・輕大娘皇女・八釣白彥皇子・大泊瀬稚武天皇・但馬橘大娘皇女・酒見皇女。","https://seisaku.bz/nihonshoki/shoki_13.html#:~:text=%E7%9A%87%E5%90%8E%E7%94%9F%E6%9C%A8%E6%A2%A8%E8%