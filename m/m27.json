{"27":[[[1,"日本書紀 巻第四 孝元天皇","次妃河內靑玉繋女埴安媛、生武埴安彥命。","https://seisaku.bz/nihonshoki/shoki_04.html#:~:text=%E6%AC%A1%E5%A6%83%E6%B2%B3%E5%85%A7%E9%9D%91%E7%8E%89%E7%B9%8B%E5%A5%B3%E5%9F%B4%E5%AE%89%E5%AA%9B"],[1,"古事記 中巻 孝元天皇","又娶河內青玉之女・名波邇夜須毘賣、生御子、建波邇夜須毘古命。","https://seisaku.bz/kojiki/kojiki_08.html#:~:text=%E5%8F%88%E5%A8%B6%E6%B2%B3%E5%85%A7%E9%9D%92%E7%8E%89%E4%B9%8B%E5%A5%B3"]],"埴安媛",1,"孝元天皇"],"59":[[],"真砥野媛",0,"垂仁天皇"],"91":[[[1,"日本書紀 巻第七 景行天皇","次妃日向髮長大田根、生日向襲津彥皇子、是阿牟君之始祖也。","https://seisaku.bz/nihonshoki/shoki_07.html#:~:text=%E6%AC%A1%E5%A6%83%E6%97%A5%E5%90%91%E9%AB%AE%E9%95%B7%E5%A4%A7%E7%94%B0%E6%A0%B9"]],"日向襲津彦皇子",0,"景行天皇"],"123":[[[1,"日本書紀 巻第七 景行天皇","初日本武尊、娶兩道入姬皇女爲妃、生稻依別王、次足仲彥天皇、次布忍入姬命、次稚武王、其兄稻依別王、是犬上君・武部君、凡二族之始祖也。","https://seisaku.bz/nihonshoki/shoki_07.html#:~:text=%E5%A8%B6%E5%85%A9%E9%81%93%E5%85%A5%E5%A7%AC%E7%9A%87%E5%A5%B3%E7%88%B2%E5%A6%83"],[1,"古事記 中巻 倭建命","又娶近淡海之安國造之祖意富多牟和氣之女・布多遲比賣、生御子、稻依別王。一柱。","https://seisaku.bz/kojiki/kojiki_11.html#:~:text=%E8%BF%91%E6%B7%A1%E6%B5%B7%E4%B9%8B%E5%AE%89%E5%9C%8B%E9%80%A0%E4%B9%8B%E7%A5%96%E6%84%8F%E5%AF%8C%E5%A4%9A%E7%89%9F%E5%92%8C%E6%B0%A3%E4%B9%8B"]],"稲依別王",1,"垂仁天皇"],"155":[[],"滋原皇女",0,"応神天皇"],"187":[[],"糸媛",0,"応神天皇"],"219":[[[1,"日本書紀 巻第十四 雄略天皇","次有春日和珥臣深目女曰童女君、生春日大娘皇女。","https://seisaku.bz/nihonshoki/shoki_14.html#:~:text=%E6%AC%A1%E6%9C%89%E6%98%A5%E6%97%A5%E5%92%8C%E7%8F%A5%E8%87%A3%E6%B7%B1%E7%9B%AE%E5%A5%B3%E6%9B%B0%E7%AB%A5%E5%A5%B3%E5%90%9B"],[1,"日本書紀 巻第十五 仁賢天皇","春日大娘皇女、大泊瀬天皇娶和珥臣深目之女童女君所生也。","https://seisaku.bz/nihonshoki/shoki_15.html#:~:text=%E7%80%AC%E5%A4%A9%E7%9A%87%E5%A8%B6%E5%92%8C%E7%8F%A5%E8%87%A3%E6%B7%B1%E7%9B%AE%E4%B9%8B%E5%A5%B3%E7%AB%A5%E5%A5%B3%E5%90%9B%E6%89%80%E7%94%9F"]],"和珥童女君",0,"雄略天皇"],"251":[[[1,"日本書紀 巻第四 孝元天皇","妃伊香色謎命、生彥太忍信命。","https://seisaku.bz/nihonshoki/shoki_04.html#:~:text=%E5%A6%83%E4%BC%8A%E9%A6%99%E8%89%B2%E8%AC%8E%E5%91%BD"],[1,"日本書紀 巻第四 開化天皇","六年春正月辛丑朔甲寅、立伊香色謎命爲皇后。","https://seisaku.bz/nihonshoki/shoki_04.html#:~:text=%E5%85%AD%E5%B9%B4%E6%98%A5%E6%AD%A3%E6%9C%88%E8%BE%