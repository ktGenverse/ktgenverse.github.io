{"0":[[[1,"日本書紀 巻第十二 履中天皇","喚鯽魚磯別王之女太姬郎姬・高鶴郎姬、納於後宮、並爲嬪。","https://seisaku.bz/nihonshoki/shoki_12.html#:~:text=%E5%96%9A%E9%AF%BD%E9%AD%9A%E7%A3%AF%E5%88%A5%E7%8E%8B%E4%B9%8B%E5%A5%B3%E5%A4%AA%E5%A7%AC%E9%83%8E%E5%A7%AC"]],"太姫郎姫",0,"履中天皇"],"32":[[[1,"日本書紀 巻第四 孝元天皇","一云、天皇母弟少彥男心命也。","https://seisaku.bz/nihonshoki/shoki_04.html#:~:text=%E5%A4%A9%E7%9A%87%E6%AF%8D%E5%BC%9F%E5%B0%91%E5%BD%A5%E7%94%B7%E5%BF%83%E5%91%BD%E4%B9%9F"],[1,"古事記 中巻 孝元天皇","此天皇、娶穗積臣等之祖・內色許男命色許二字以音、下效此妹・內色許賣命、生御子、大毘古命、次少名日子建猪心命、次若倭根子日子大毘毘命。三柱。","https://seisaku.bz/kojiki/kojiki_08.html#:~:text=%E6%AC%A1%E8%8B%A5%E5%80%AD%E6%A0%B9%E5%AD%90%E6%97%A5%E5%AD%90%E5%A4%A7%E6%AF%98%E6%AF%98%E5%91%BD"]],"少彦男心命",0,"孝元天皇"],"64":[[],"袁那弁王",0,"垂仁天皇"],"96":[[[1,"日本書紀 巻第七 景行天皇","於是其國有佳人、曰御刀媛御刀、此云彌波迦志、則召爲妃。生豐國別皇子、是日向國造之始祖也。","https://seisaku.bz/nihonshoki/shoki_07.html#:~:text=%E6%98%AF%E6%97%A5%E5%90%91%E5%9C%8B%E9%80%A0%E4%B9%8B%E5%A7%8B%E7%A5%96%E4%B9%9F"]],"日向御刀媛",0,"景行天皇"],"128":[[],"比古須泥王",0,"開化天皇"],"160":[[[1,"日本書紀 巻第十 応神天皇","次妃和珥臣祖日觸使主之女宮主宅媛、生菟道稚郎子皇子・矢田皇女・雌鳥皇女。","https://seisaku.bz/nihonshoki/shoki_10.html#:~:text=%E6%AC%A1%E5%A6%83%E5%92%8C%E7%8F%A5%E8%87%A3%E7%A5%96%E6%97%A5%E8%A7%B8%E4%BD%BF%E4%B8%BB%E4%B9%8B%E5%A5%B3%E5%AE%AE%E4%B8%BB%E5%AE%85%E5%AA%9B"],[1,"古事記 中巻 応神天皇","又、娶丸邇之比布禮能意富美之女自比至美以音名宮主矢河枝比賣、生御子、宇遲能和紀郎子、次妹八田若郎女、次女鳥王。三柱。","https://seisaku.bz/kojiki/kojiki_13.html#:~:text=%E9%82%87%E4%B9%8B%E6%AF%94%E5%B8%83%E7%A6%AE%E8%83%BD%E6%84%8F%E5%AF%8C%E7%BE%8E%E4%B9%8B%E5%A5%B3%E8%87%AA%E6%AF%94%E8%87%B3%E7%BE%8E%E4%BB%A5"]],"雌鳥皇女",0,"応神天皇"],"192":[[[1,"日本書紀 巻第十一 仁徳天皇","二年春三月辛未朔戊寅、立磐之媛命爲皇后。皇后生大兄去來穗別天皇・住吉仲皇子・瑞齒別天皇・雄朝津間稚子宿禰天皇。","https://seisaku.bz/nihonshoki/shoki_11.html#:~:text=%E7%9A%87%E5%90%8E%E7%94%9F%E5%A4%A7%E5%85%84%E5%8E%BB%E4%BE%86%E7%A9%97%E5%88%A5%E5%A4%A9%E7%9A%87"],[1,"日本書紀 巻第十二 履中天皇","母曰磐之媛命、葛城襲津彥女也。","https://seisaku.bz/nihonshoki/shoki_12.html#:~:text=%E8%91%9B%E5%9F%8E%E8%A5%B2%E6%B4%A5%E5%BD%A5%E5%A5%B3%E4%B9%9F"],[1,"古事記 下巻 仁徳天皇","此天皇、娶葛城之曾都毘古之女・石之日賣命大后、生御子、大江之伊邪本和氣命、次墨江之中津王、次蝮之水齒別命、次男淺津間若子宿禰命。四柱。","https://seisaku.bz/kojiki/kojiki_14.html#:~:text=%E5%A8%B6%E8%91%9B%E5%9F%8E%E4%B9%8B%E6%9B%BE%E9%83%BD%E6%AF%98%E5%8F%A4%E4%B9%8B%E5%A5%B3"]],"磐之媛命",1,"仁徳天皇"],"224":[[],"磐坂市辺押磐皇子",0,"履中天皇"],"256":[[[1,"日本書紀 巻第十三 安康天皇","穴穗天皇、雄朝津間稚子宿禰天皇第二子也。","https://seisaku.bz/nihonshoki/shoki_13.html#:~:text=%E9%9B%84%E6%9C%9D%E6%B4%A5%E9%96%93%E7%A8%9A%E5%AD%90%E5%AE%BF%E7%A6%B0%E5%A4%A9%E7%9A%87%E7%AC%AC%E4%BA%8C%E5%AD%90%E4%B9%9F"],[1,"日本書紀 巻第十三 安康天皇","母曰忍坂大中姬命、稚渟毛二岐皇子之女也。","https://seisaku.bz/nihonshoki/shoki_13.html#:~:text=%E7%A8%9A%E6%B8%9F%E6%AF%9B%E4%BA%8C%E5%B2%90%E7%9A%87%E5%AD%90%E4%B9%8B%E5%A5%B3%E4%B9%9F"],[1,"日本書紀 巻第十三 安康天皇","爰取大草香皇子之妻中蒂姬納于宮中因爲妃、復遂喚幡梭皇女配大泊瀬皇子。","https://seisaku.bz/nihonshoki/shoki_13.html#:~:text=%E5%A4%A7%E8%8D%89%E9%A6%99%E7%9A%87%E5%AD%90%E4%B9%8B%E5%A6%BB%E4%B8%AD%E8%92%82%E5%A7%AC%E7%B4%8D%E4%BA%8E%E5%AE%AE%E4%B8%AD%E5%9B%A0%E7%88%B2"],[1,"日本書紀 巻第十三 安康天皇","二年春正月癸巳朔己酉、立中蒂姬命爲皇后、甚寵也。","https://seisaku.bz/nihonshoki/shoki_13.html#:~:text=%E4%BA%8C%E5%B9%B4%E6%98%A5%E6%AD%A3%E6%9C%88%E7%99%B8%E5%B7%B3%E6%9C%94%E5%B7%B1%E9%85%89"],[1,"日本書紀 巻第十三 安康天皇","初中蒂姬命生眉輪王於大草香皇子、乃依母以得免罪、常養宮中。","https://seisaku.bz/nihonshoki/shoki_13.html#:~:text=%E5%88%9D%E4%B8%AD%E8%92%82%E5%A7%AC%E5%91%BD%E7%94%9F%E7%9C%89%E8%BC%AA%E7%8E%8B%E6%96%BC%E5%A4%A7%E8%8D%89%E9%A6%99%E7%9A%87%E5%AD%90"],[1,"古事記 下巻 安康天皇","故、天皇大怒、殺大日下王而、取持來其王之嫡妻・長田大郎女、爲皇后。","https://seisaku.bz/kojiki/kojiki_15.html#:~:text=%E5%8F%96%E6%8C%81%E4%BE%86%E5%85%B6%E7%8E%8B%E4%B9%8B%E5%AB%A1%E5%A6%BB"],[1,"古事記 下巻 安康天皇","於是、其大后先子・目弱王、是年七歲、","https://seisaku.bz/kojiki/kojiki_15.html#:~:text=%E5%85%B6%E5%A4%A7%E5%90%8E%E5%85%88%E5%AD%90"]],"安康天皇",1,""],"288":[[],"都奴牟斯君",0,""],"320":[[[1,"日本書紀 巻第十八 安閑天皇","別立三妃、立許勢男人大臣女紗手媛、紗手媛弟香々有媛、物部木蓮子木蓮子、此云伊陀寐大蓮女宅媛。","https://seisaku.bz/nihonshoki/shoki_18.html#:~:text=%E7%AB%8B%E8%A8%B1%E5%8B%A2%E7%94%B7%E4%BA%BA%E5%A4%A7%E8%87%A3%E5%A5%B3%E7%B4%97%E6%89%8B%E5%AA%9B"]],"許勢紗手媛",0,"安閑天皇"],"352":[[],"肩野皇女",0,"欽明天皇"],"384":[[[1,"日本書紀 巻第二十三 舒明天皇","息長足日廣額天皇、渟中倉太珠敷天皇孫