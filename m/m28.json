{"28":[[[1,"日本書紀 巻第四 孝元天皇","次妃河內靑玉繋女埴安媛、生武埴安彥命。","https://seisaku.bz/nihonshoki/shoki_04.html#:~:text=%E6%AC%A1%E5%A6%83%E6%B2%B3%E5%85%A7%E9%9D%91%E7%8E%89%E7%B9%8B%E5%A5%B3%E5%9F%B4%E5%AE%89%E5%AA%9B"]],"武埴安彦命",1,"孝元天皇"],"60":[[[1,"日本書紀 巻第六 垂仁天皇","次妃薊瓊入媛、生池速別命・稚淺津姬命。","https://seisaku.bz/nihonshoki/shoki_06.html#:~:text=%E6%AC%A1%E5%A6%83%E8%96%8A%E7%93%8A%E5%85%A5%E5%AA%9B"]],"薊瓊入媛",0,"垂仁天皇"],"92":[[[1,"日本書紀 巻第七 景行天皇","次妃襲武媛、生國乳別皇子與國背別皇子一云宮道別皇子・豐戸別皇子、其兄國乳別皇子、是水沼別之始祖也、弟豐戸別皇子、是火國別之始祖也。","https://seisaku.bz/nihonshoki/shoki_07.html#:~:text=%E4%B9%B3%E5%88%A5%E7%9A%87%E5%AD%90%E8%88%87%E5%9C%8B%E8%83%8C%E5%88%A5%E7%9A%87%E5%AD%90%E4%B8%80%E4%BA%91%E5%AE%AE%E9%81%93%E5%88%A5%E7%9A%87"]],"襲武媛",0,"景行天皇"],"124":[[[1,"日本書紀 巻第七 景行天皇","初日本武尊、娶兩道入姬皇女爲妃、生稻依別王、次足仲彥天皇、次布忍入姬命、次稚武王、其兄稻依別王、是犬上君・武部君、凡二族之始祖也。","https://seisaku.bz/nihonshoki/shoki_07.html#:~:text=%E5%A8%B6%E5%85%A9%E9%81%93%E5%85%A5%E5%A7%AC%E7%9A%87%E5%A5%B3%E7%88%B2%E5%A6%83"]],"布忍入姫命",0,"垂仁天皇"],"156":[[[1,"古事記 中巻 応神天皇","弟日賣命之御子、阿倍郎女、次阿具知能此四字以音三腹郎女、次木之菟野郎女、次三野郎女。五柱。","https://seisaku.bz/kojiki/kojiki_13.html#:~:text=%E5%BC%9F%E6%97%A5%E8%B3%A3%E5%91%BD%E4%B9%8B%E5%BE%A1%E5%AD%90"]],"三野郎女",0,"応神天皇"],"188":[[[1,"日本書紀 巻第四 安寧天皇","三年春正月戊寅朔壬午、立渟名底仲媛命亦曰渟名襲媛爲皇后。","https://seisaku.bz/nihonshoki/shoki_04.html#:~:text=%E7%AB%8B%E6%B8%9F%E5%90%8D%E5%BA%95%E4%BB%B2%E5%AA%9B%E5%91%BD%E4%BA%A6%E6%9B%B0%E6%B8%9F%E5%90%8D%E8%A5%B2%E5%AA%9B%E7%88%B2%E7%9A%87%E5%90%8E"],[1,"日本書紀 巻第六 垂仁天皇","皇后日葉酢媛命、生三男二女、第一曰五十瓊敷入彥命、第二曰大足彥尊、第三曰大中姬命、第四曰倭姬命、第五曰稚城瓊入彥命。","https://seisaku.bz/nihonshoki/shoki_06.html#:~:text=%E7%AC%AC%E4%B8%80%E6%9B%B0%E4%BA%94%E5%8D%81%E7%93%8A%E6%95%B7%E5%85%A5%E5%BD%A5%E5%91%BD"],[1,"日本書紀 巻第十一 仁徳天皇","大鷦鷯天皇、譽田天皇之第四子也。母曰仲姬命、五百城入彥皇子之孫也。","https://seisaku.bz/nihonshoki/shoki_11.html#:~:text=%E4%BA%94%E7%99%BE%E5%9F%8E%E5%85%A5%E5%BD%A5%E7%9A%87%E5%AD%90%E4%B9%8B%E5%AD%AB%E4%B9%9F"],[1,"古事記 下巻 宣化天皇","天皇、娶意祁天皇之御子・橘之中比賣命、生御子、石比賣命訓石如石、下效此、次小石比賣命、次倉之若江王。","https://seisaku.bz/kojiki/kojiki_17.html#:~:text=%E5%A8%B6%E6%84%8F%E7%A5%81%E5%A4%A9%E7%9A%87%E4%B9%8B%E5%BE%A1%E5%AD%90"],[1,"古事記 中巻 応神天皇","此天皇、娶品陀眞若王品陀二字以音之女三柱女王、一名高木之入日賣命、次中日賣命、次弟日賣命。","https://seisaku.bz/kojiki/kojiki_13.html#:~:text=%E4%B8%80%E5%90%8D%E9%AB%98%E6%9C%A8%E4%B9%8B%E5%85%A5%E6%97%A5%E8%B3%A3%E5%91%BD"]],"仲姫命",1,"応神天皇"],"220":[[[1,"日本書紀 巻第十五 清寧天皇","白髮武廣國押稚日本根子天皇、大泊瀬幼武天皇第三子也、母曰葛城韓媛。","https://seisaku.bz/nihonshoki/shoki_15.html#:~:text=%E7%99%BD%E9%AB%AE%E6%AD%A6%E5%BB%A3%E5%9C%8B%E6%8A%BC%E7%A8%9A%E6%97%A5%E6%9C%AC%E6%A0%B9%E5%AD%90%E5%A4%A9%E7%9A%87"],[1,"古事記 下巻 清寧天皇","此天皇、無皇后、亦無御子、故御名代定白髮部。","https://seisaku.bz/kojiki/kojiki_17.html#:~:text=%E6%95%85%E5%BE%A1%E5%90%8D%E4%BB%A3%E5%AE%9A%E7%99%BD%E9%AB%AE%E9%83%A8"]],"清寧天皇",1,""],"252":[[[1,"古事記 中巻 応神天皇","又娶日向之泉長比賣、生御子、大羽江王、次小羽江王、次幡日之若郎女。三柱。","https://seisaku.bz/kojiki/kojiki_13.html#:~:text=%E5%8F%88%E5%A8%B6%E6%97%A5%E5%90%91%E4%B9%8B%E6%B3%89%E9%95%B7%E6%AF%94%E8%B3%A3"]],"幡日之若郎女",0,"応神天皇"],"316":[[],"広媛",0,"継体天皇"],"348":[[[1,"日本書紀 巻第二十一 用明天皇","橘豐日天皇、天國排開廣庭天皇第四子也、母曰堅鹽媛。","https://seisaku.bz/nihonshoki/shoki_21.html#:~:text=%E5%A4%A9%E5%9C%8B%E6%8E%92%E9%96%8B%E5%BB%A3%E5%BA%AD%E5%A4%A9%E7%9A%87%E7%AC%AC%E5%9B%9B%E5%AD%90%E4%B9%9F"],[1,"日本書紀 巻第二十一 用明天皇","立穴穗部間人皇女爲皇后、是生四男、其一曰廐戸皇子更名豐耳聰聖德、或名豐聰耳法大王、或云法主王、","https://seisaku.bz/nihonshoki/shoki_21.html#:~:text=%E5%85%B6%E4%B8%80%E6%9B%B0%E5%BB%90%E6%88%B8%E7%9A%87%E5%AD%90%E6%9B%B4%E5%90%8D%E8%B1%90%E8%80%B3%E8%81%B0%E8%81%96%E5%BE%B7"],[1,"日本書紀 巻第二十一 用明天皇","其二曰來目皇子、其三曰殖栗皇子、其四曰茨田皇子。","https://seisaku.bz/nihonshoki/shoki_21.html#:~:text=%E5%85%B6%E4%BA%8C%E6%9B%B0%E4%BE%86%E7%9B%AE%E7%9A%87%E5%AD%90"],[1,"日本書紀 巻第二十一 用明天皇","立蘇我大臣稻目宿禰女石寸名爲嬪、是生田目皇子更名豐浦皇子。","https://seisaku.bz/nihonshoki/shoki_21.html#:~:text=%E7%AB%8B%E8%98%87%E6%88%91%E5%A4%A7%E8%87%A3%E7%A8%BB%E7%9B%AE%E5%AE%BF%E7%A6%B0%E5%A5%B3%E7%9F%B3%E5%AF%B8%E5%90%8D%E7%88%B2%E5%AC%AA"],[1,"日本書紀 巻第二十一 用明天皇","葛城直磐村女廣子、生一男一女、男曰麻呂子皇子、此當麻公之先也、女曰酢香手姬皇女、歷三代以奉日神。","https://seisaku.bz/nihonshoki/shoki_21.html#:~:text=%E8%91%9B%E5%9F%8E%E7%9B%B4%E7%A3%90%E6%9D%91%E5%A5%B3%E5%BB%A3%