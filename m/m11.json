{"11":[[[1,"日本書紀 巻第四 孝昭天皇","廿九年春正月甲辰朔丙午、立世襲足媛爲皇后。","https://seisaku.bz/nihonshoki/shoki_04.html#:~:text=%E5%BB%BF%E4%B9%9D%E5%B9%B4%E6%98%A5%E6%AD%A3%E6%9C%88%E7%94%B2%E8%BE%B0%E6%9C%94%E4%B8%99%E5%8D%88"]],"世襲足媛",0,"孝昭天皇"],"43":[[],"比古伊那許志別命",0,"孝元天皇"],"75":[[[1,"日本書紀 巻第六 垂仁天皇","二年春二月辛未朔己卯、立狹穗姬爲皇后。后生譽津別命、生而天皇愛之、常在左右、及壯而不言。","https://seisaku.bz/nihonshoki/shoki_06.html#:~:text=%E4%BA%8C%E5%B9%B4%E6%98%A5%E4%BA%8C%E6%9C%88%E8%BE%9B%E6%9C%AA%E6%9C%94%E5%B7%B1%E5%8D%AF"]],"誉津別命",1,"垂仁天皇"],"107":[[[1,"日本書紀 巻第七 景行天皇","后生二男、第一曰大碓皇子、第二曰小碓尊。","https://seisaku.bz/nihonshoki/shoki_07.html#:~:text=%E7%AC%AC%E4%B8%80%E6%9B%B0%E5%A4%A7%E7%A2%93%E7%9A%87%E5%AD%90"],[1,"古事記 中巻 景行天皇","生御子、櫛角別王、次大碓命、次小碓命・亦名倭男具那命具那二字以音、次倭根子命、次神櫛王。五柱。","https://seisaku.bz/kojiki/kojiki_11.html#:~:text=%E4%BA%A6%E5%90%8D%E5%80%AD%E7%94%B7%E5%85%B7%E9%82%A3%E5%91%BD"]],"大碓皇子",1,"景行天皇"],"139":[[],"虚空津比売命",0,""],"171":[[],"建稲種命",0,""],"203":[[[1,"日本書紀 巻第十二 反正天皇","立大宅臣祖木事之女津野媛、爲皇夫人、生香火姬皇女・圓皇女。","https://seisaku.bz/nihonshoki/shoki_12.html#:~:text=%E7%AB%8B%E5%A4%A7%E5%AE%85%E8%87%A3%E7%A5%96%E6%9C%A8%E4%BA%8B%E4%B9%8B%E5%A5%B3%E6%B4%A5%E9%87%8E%E5%AA%9B"]],"円皇女",0,"反正天皇"],"235":[[],"中斯知命",0,""],"267":[[[1,"日本書紀 巻第十四 雄略天皇","立草香幡梭姬皇女、爲皇后。更名橘姬皇女。","https://seisaku.bz/nihonshoki/shoki_14.html#:~:text=%E7%AB%8B%E8%8D%89%E9%A6%99%E5%B9%A1%E6%A2%AD%E5%A7%AC%E7%9A%87%E5%A5%B3"],[1,"古事記 下巻 雄略天皇","天皇、娶大日下王之妹・若日下部王。无子。","https://seisaku.bz/kojiki/kojiki_16.html#:~:text=%E5%A8%B6%E5%A4%A7%E6%97%A5%E4%B8%8B%E7%8E%8B%E4%B9%8B%E5%A6%B9"]],"草香幡梭姫皇女",0,"仁徳天皇"],"299":[[[1,"日本書紀 巻第十七 継体天皇","次、息長眞手王女曰麻績娘子、生荳角皇女荳角、此云娑佐礙、是侍伊勢大神祠。","https://seisaku.bz/nihonshoki/shoki_17.html#:~:text=%E6%81%AF%E9%95%B7%E7%9C%9E%E6%89%8B%E7%8E%8B%E5%A5%B3%E6%9B%B0%E9%BA%BB%E7%B8%BE%E5%A8%98%E5%AD%90"]],"息長麻績娘子",0,"継体天皇"],"331":[[[1,"日本書紀 巻第十八 宣化天皇","是生一男三女、長曰石姬皇女、次曰小石姬皇女、次曰倉稚綾姬皇女、次曰上殖葉皇子、亦名椀子、是丹比公・偉那公、凡二姓之先也。","https://seisaku.bz/nihonshoki/shoki_18.html#:~:text=%E6%AC%A1%E6%9B%B0%E5%80%89%E7%A8%9A%E7%B6%BE%E5%A7%AC%E7%9A%87%E5%A5%B3"]],"小石姫皇女",0