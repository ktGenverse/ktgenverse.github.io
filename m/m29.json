{"29":[[[1,"日本書紀 巻第四 孝元天皇","妃伊香色謎命、生彥太忍信命。","https://seisaku.bz/nihonshoki/shoki_04.html#:~:text=%E5%A6%83%E4%BC%8A%E9%A6%99%E8%89%B2%E8%AC%8E%E5%91%BD"],[1,"古事記 中巻 孝元天皇","又娶內色許男命之女・伊賀迦色許賣命、生御子、比古布都押之信命。","https://seisaku.bz/kojiki/kojiki_08.html#:~:text=%E5%8F%88%E5%A8%B6%E5%85%A7%E8%89%B2%E8%A8%B1%E7%94%B7%E5%91%BD%E4%B9%8B%E5%A5%B3"]],"彦太忍信命",0,"孝元天皇"],"61":[[[1,"日本書紀 巻第六 垂仁天皇","次妃薊瓊入媛、生池速別命・稚淺津姬命。","https://seisaku.bz/nihonshoki/shoki_06.html#:~:text=%E6%AC%A1%E5%A6%83%E8%96%8A%E7%93%8A%E5%85%A5%E5%AA%9B"]],"息速別命",0,"垂仁天皇"],"93":[[[1,"日本書紀 巻第七 景行天皇","次妃襲武媛、生國乳別皇子與國背別皇子一云宮道別皇子・豐戸別皇子、其兄國乳別皇子、是水沼別之始祖也、弟豐戸別皇子、是火國別之始祖也。","https://seisaku.bz/nihonshoki/shoki_07.html#:~:text=%E4%B9%B3%E5%88%A5%E7%9A%87%E5%AD%90%E8%88%87%E5%9C%8B%E8%83%8C%E5%88%A5%E7%9A%87%E5%AD%90%E4%B8%80%E4%BA%91%E5%AE%AE%E9%81%93%E5%88%A5%E7%9A%87"]],"国乳別皇子",0,"景行天皇"],"125":[[[1,"日本書紀 巻第七 景行天皇","初日本武尊、娶兩道入姬皇女爲妃、生稻依別王、次足仲彥天皇、次布忍入姬命、次稚武王、其兄稻依別王、是犬上君・武部君、凡二族之始祖也。","https://seisaku.bz/nihonshoki/shoki_07.html#:~:text=%E5%A8%B6%E5%85%A9%E9%81%93%E5%85%A5%E5%A7%AC%E7%9A%87%E5%A5%B3%E7%88%B2%E5%A6%83"]],"稚武王",0,"垂仁天皇"],"157":[[[1,"日本書紀 巻第十 応神天皇","次妃和珥臣祖日觸使主之女宮主宅媛、生菟道稚郎子皇子・矢田皇女・雌鳥皇女。","https://seisaku.bz/nihonshoki/shoki_10.html#:~:text=%E6%AC%A1%E5%A6%83%E5%92%8C%E7%8F%A5%E8%87%A3%E7%A5%96%E6%97%A5%E8%A7%B8%E4%BD%BF%E4%B8%BB%E4%B9%8B%E5%A5%B3%E5%AE%AE%E4%B8%BB%E5%AE%85%E5%AA%9B"],[1,"古事記 中巻 応神天皇","又、娶丸邇之比布禮能意富美之女自比至美以音名宮主矢河枝比賣、生御子、宇遲能和紀郎子、次妹八田若郎女、次女鳥王。三柱。","https://seisaku.bz/kojiki/kojiki_13.html#:~:text=%E9%82%87%E4%B9%8B%E6%AF%94%E5%B8%83%E7%A6%AE%E8%83%BD%E6%84%8F%E5%AF%8C%E7%BE%8E%E4%B9%8B%E5%A5%B3%E8%87%AA%E6%AF%94%E8%87%B3%E7%BE%8E%E4%BB%A5"]],"宮主宅媛",0,"応神天皇"],"189":[[[1,"日本書紀 巻第十 応神天皇","立仲姬爲皇后、后生荒田皇女・大鷦鷯天皇・根鳥皇子。","https://seisaku.bz/nihonshoki/shoki_10.html#:~:text=%E7%AB%8B%E4%BB%B2%E5%A7%AC%E7%88%B2%E7%9A%87%E5%90%8E"],[1,"古事記 中巻 応神天皇","中日賣命之御子、木之荒田郎女、次大雀命、次根鳥命。三柱。","https://seisaku.bz/kojiki/kojiki_13.html#:~:text=%E4%B8%AD%E6%97%A5%E8%B3%A3%E5%91%BD%E4%B9%8B%E5%BE%A1%E5%AD%90"]],"荒田皇女",0,"応神天皇"],"221":[[[1,"日本書紀 巻第十四 雄略天皇","元妃葛城圓大臣女曰韓媛、生白髮武廣國押稚日本根子天皇與稚足姬皇女更名𣑥幡娘姬皇女","https://seisaku.bz/nihonshoki/shoki_14.html#:~:text=%E9%AB%AE%E6%AD%A6%E5%BB%A3%E5%9C%8B%E6%8A%BC%E7%A8%9A%E6%97%A5%E6%9C%AC%E6%A0%B9%E5%AD%90%E5%A4%A9%E7%9A%87%E8%88%87%E7%A8%9A%E8%B6%B3%E5%A7%AC"]],"栲幡姫皇女",0,"雄略天皇"],"253":[[[1,"日本書紀 巻第十二 履中天皇","去來穗別天皇、大鷦鷯天皇太子也。","https://seisaku.bz/nihonshoki/shoki_12.html#:~:text=%E5%A4%A7%E9%B7%A6%E9%B7%AF%E5%A4%A9%E7%9A%87%E5%A4%AA%E5%AD%90%E4%B9%9F"],[1,"日本書紀 巻第十二 履中天皇","母曰磐之媛命、葛城襲津彥女也。","https://seisaku.bz/nihonshoki/shoki_12.html#:~:text=%E8%91%9B%E5%9F%8E%E8%A5%B2%E6%B4%A5%E5%BD%A5%E5%A5%B3%E4%B9%9F"],[1,"日本書紀 巻第十二 履中天皇","秋七月己酉朔壬子、立葦田宿禰之女黑媛、爲皇妃、妃生磐坂市邊押羽皇子・御馬皇子・靑海皇女。","https://seisaku.bz/nihonshoki/shoki_12.html#:~:text=%E5%A6%83%E7%94%9F%E7%A3%90%E5%9D%82%E5%B8%82%E9%82%8A%E6%8A%BC%E7%BE%BD%E7%9A%87%E5%AD%90"],[1,"日本書紀 巻第十二 履中天皇","次妃幡梭皇女、生中磯皇女。","https://seisaku.bz/nihonshoki/shoki_12.html#:~:text=%E6%AC%A1%E5%A6%83%E5%B9%A1%E6%A2%AD%E7%9A%87%E5%A5%B3"],[1,"日本書紀 巻第十二 履中天皇","六年春正月癸未朔戊子、立草香幡梭皇女、爲皇后。","https://seisaku.bz/nihonshoki/shoki_12.html#:~:text=%E5%85%AD%E5%B9%B4%E6%98%A5%E6%AD%A3%E6%9C%88%E7%99%B8%E6%9C%AA%E6%9C%94%E6%88%8A%E5%AD%90"],[1,"古事記 下巻 履中天皇","此天皇、娶葛城之曾都毘古之子・葦田宿禰之女・名黑比賣命、生御子、市邊之忍齒王、次御馬王、次妹青海郎女・亦名飯豐郎女。三柱。","https://seisaku.bz/kojiki/kojiki_15.html#:~:text=%E5%A8%B6%E8%91%9B%E5%9F%8E%E4%B9%8B%E6%9B%BE%E9%83%BD%E6%AF%98%E5%8F%A4%E4%B9%8B%E5%AD%90"]],"履中天皇",1,""],"285":[[[1,"日本書紀 巻第九 神功皇后","氣長足姬尊、稚日本根子彥大日々天皇之曾孫、氣長宿禰王之女也、母曰葛城高顙媛。","https://seisaku.bz/nihonshoki/shoki_09.html#:~:text=%E7%A8%9A%E6%97%A5%E6%9C%AC%E6%A0%B9%E5%AD%90%E5%BD%A5%E5%A4%A7%E6%97%A5%E3%80%85%E5%A4%A9%E7%9A%87%E4%B9%8B%E6%9B%BE%E5%AD%AB"],[1,"日本書紀 巻第九 神功皇后","足仲彥天皇二年、立爲皇后、幼而聰明叡智、貌容壯麗。","https://seisaku.bz/nihonshoki/shoki_09.html#:~:text=%E8%B6%B3%E4%BB%B2%E5%BD%A5%E5%A4%A9%E7%9A%87%E4%BA%8C%E5%B9%B4"],[1,"日本書紀 巻第九 神功皇后","十二月戊戌朔辛亥、生譽田天皇於筑紫。","https://seisaku.bz/nihonshoki/shoki_09.html#:~:text=%E5%8D%81%E4%BA%8C%E6%9C%88%E6%88%8A%E6%88%8C%E6%9C%94%E8%BE%9B%E4%BA%A5"],[1,"日本書紀 巻第九 神功皇后","麛坂王・忍熊王、聞天皇崩亦皇后西征幷皇子新生、而密謀之曰","https://seisaku.bz/nihonshoki/shoki_09.html#:~:text=%E8%81%9E%E5%A4%A9%E7%9A%87%E5%B4%A9%E4%BA%A6%E7%9A%87%E5%90%8E%E8%A5%BF%E5%BE%81%E5%B9%B7%E7%9A%87%E5%AD%90%E6%96%B0%E7%94%9F"],[1,"古事記 中巻 神功皇后","其大后息長帶日賣命者、當時歸神。","https://seisaku.bz/kojiki/kojiki_12.html#:~:text=%E5%85%B6%E5%A4%A7%E5%90%8E%E6%81%AF%E9%95%B7%E5%B8%B6%E6%97%A5%E8%B3%A3%E5%91%BD%E8%80%85"]],"神功皇后",1,"仲哀天皇"],"317":[[[1,"日本書紀 巻第十七 継体天皇","甲子、立皇后手白香皇女、修教于內、遂生一男、是爲天國排開廣庭尊。","https://seisaku.bz/nihonshoki/shoki_17.html#:~:text=%E6%98%AF%E7%88%B2%E5%A4%A9%E5%9C%8B%E6%8E%92%E9%96%8B%E5%BB%A3%E5%BA%AD%E5%B0%8A"],[1,"日本書紀 巻第十五 仁賢天皇","遂産一男六女、其一曰高橋大娘皇女、其二曰朝嬬皇女、其三曰手白香皇女、其四曰樟氷皇女、其五曰橘皇女、其六曰小泊瀬稚鷦鷯天皇、及有天下都泊瀬列城、其七曰眞稚皇女。","https://seisaku.bz/nihonshoki/shoki_15.html#:~:text=%E5%85%B6%E5%85%AD%E6%9B%B0%E5%B0%8F%E6%B3%8A%E7%80%AC%E7%A8%9A%E9%B7%A6%E9%B7%AF%E5%A4%A9%E7%9A%87"],[1,"古事記 下巻 継体天皇","又娶意祁天皇之御子・手白髮命是大后也生御子、天國押波流岐廣庭命。","https://seisaku.bz/kojiki/kojiki_17.html#:~:text=%E6%89%8B%E7%99%BD%E9%AB%AE%E5%91%BD%E6%98%AF%E5%A4%A7%E5%90%8E%E4%B9%9F%E7%94%9F%E5%BE%A1%E5%AD%90"]],"手白香皇女",1,"仁賢天皇"],"349":[[],"磐隈皇女",0,"欽明天皇"],"381":[[[1,"日本書紀 巻第二十 敏達天皇","是月、立一夫人、春日臣仲君女曰老女子夫人更名藥君娘、生三男一女、其一曰難波皇子、其二曰春日皇子、其三曰桑田皇女、其四曰大派皇子。","https://seisaku.bz/nihonshoki/shoki_20.html#:~:text=%E8%87%A3%E4%BB%B2%E5%90%9B%E5%A5%B3%E6%9B%B0%E8%80%81%E5%A5%B3%E5%AD%90%E5%A4%AB%E4%BA%BA%E6%9B%B4%E5%90%8D%E8%97%A5%E5%90%9B%E5%A8%98"],[1,"古事記 下巻 継体天皇","又娶坂田大俣王之女・黑比賣、生御子、神前郎女、次田郎女、次白坂活日子郎女、次野郎女・亦名長目比賣。四柱。","https://seisaku.bz/kojiki/kojiki_17.html#:~:text=%E5%8F%88%E5%A8%B6%E5%9D%82%E7%94%B0%E5%A4%A7%E4%BF%A3%E7%8E%8B%E4%B9%8B%E5%A5%B3"],[1,"古事記 下巻 敏達天皇","又娶春日中若子之女・老女子郎女、生御子、難波王、次桑田王、次春日王、次大俣王。四柱。","https://seisaku.bz/kojiki/kojiki_17.html#:~:text=%E5%8F%88%E5%A8%B6%E6%98%A5%E6%97%A5%E4%B8%AD%E8%8B%A5%E5%AD%90%E4%B9%8B%E5%A5%B3"]],"大派皇子",0,"敏達天皇"],"413":[[[1,"日本書紀 巻第二十七 天智天皇","有蘇我山田石川麻呂大臣女曰遠智娘或本云美濃津子娘、生一男二女、其一曰大田皇女、其二曰鸕野皇女、及有天下居于飛鳥淨御原宮、後移宮于藤原、其三曰建皇子、唖不能語。","https://seisaku.bz/nihonshoki/shoki_27.html#:~:text=%E6%88%91%E5%B1%B1%E7%94%B0%E7%9F%B3%E5%B7%9D%E9%BA%BB%E5%91%82%E5%A4%A7%E8%87%A3%E5%A5%B3%E6%9B%B0%E9%81%A0%E6%99%BA%E5%A8%98%E6%88%96%E6%9C%AC"],[1,"日本書紀 巻第二十七 天智天皇","次有遠智娘弟曰姪娘、生御名部皇女與阿陪皇女、阿陪皇女及有天下居于藤原宮後移都于乃樂。","https://seisaku.bz/nihonshoki/shoki_27.html#:~:text=%E7%9A%87%E5%A5%B3%E5%8F%8A%E6%9C%89%E5%A4%A9%E4%B8%8B%E5%B1%85%E4%BA%8E%E8%97%A4%E5%8E%9F%E5%AE%AE%E5%BE%8C%E7%A7%BB%E9%83%BD%E4%BA%8E%E4%B9%83"],[1,"日本書紀 巻第三十 持統天皇","高天原廣野姬天皇、少名鸕野讚良皇女、天命開別天皇第二女也、母曰遠智娘更名美濃津子娘、天皇深沈有大度。","https://seisaku.bz/nihonshoki/shoki_30.html#:~:text=%E6%AF%8D%E6%9B%B0%E9%81%A0%E6%99%BA%E5%A8%98%E6%9B%B4%E5%90%8D%E7%BE%8E%E6%BF%83%E6%B4%A5%E5%AD%90%E5%A8%98"]],"遠智娘",0,"天智天皇"],"445":[[[1,"日本書紀 巻第二十九 天武天皇","次妃大江皇女、生長皇子與弓削皇子。","https://seisaku.bz/nihonshoki/shoki_29.html#:~:text=%E7%94%9F%E9%95%B7%E7%9A%87%E5%AD%90%E8%88%87%E5%BC%93%E5%89%8A%E7%9A%87%E5%AD%90"]],"弓削皇子",1,"天武天皇"],"477":[[[1,"日本書紀 巻第二十七 天智天皇","又有越道君伊羅都賣、生施基皇子。","https://seisaku.bz/nihonshoki/shoki_27.html#:~:text=%E5%8F%88%E6%9C%89%E8%B6%8A%E9%81%93%E5%90%9B%E4%BC%8A%E7%BE%85%E9%83%BD%E8%B3%A3"]],"基親王",1,"聖武天皇"],"509":[[],"稚屋彦命",0,"景行天皇"],"541":[[],"多治比真宗",0,"桓武天皇"],"573":[[],"百済王貴命",0,"嵯峨天皇"],"605":[[],"源継",0,"嵯峨天皇"],"637":[[],"源清",0,"嵯峨天皇"],"669":[[],"是貞親王",0,"光孝天皇"],"701":[[],"満子女王",0,"醍醐天皇"],"733":[[],"敏子内親王",0,"醍醐天皇"],"765":[[],"荘子女王",0,"村上天皇"],"797":[[],"藤原媓子",0,"円融天皇"],"829":[[],"深観",0,"花山天皇"],"861":[[],"高階為行",0,"後冷泉天皇"],"893":[[],"行慶",0,"白河天皇"],"925":[[],"二条天皇",1,""],"957":[[],"帥局",1,"高倉天皇"],"989":[[],"治部卿局",0,"土御門天皇"],"1021":[[],"知子女王",0,"土御門天皇"],"1053":[[],"亀山天皇",1,""],"1085":[[],"常仁親王",0,"後深草天皇"],"1117":[[],"洞院英子",0,"伏見天皇"],"1149":[[],"聖珍法親王",0,"伏見天皇"],"1181":[[],"㛹子内親王",0,"後二条天皇"],"1213":[[],"寿子内親王",0,"花園天皇"],"1245":[[],"説成親王",0,"後村上天皇"],"1277":[[],"良泰親王",0,"後亀山天皇"],"1309":[[],"真乗寺宮",0,"後花園天皇"],"1341":[[],"邦輔親王",0,""],"1373":[[],"文高女王",0,"後陽成天皇"],"1405":[[],"高仁親王",0,"後水尾天皇"],"1437":[[],"道寛法親王",0,"後水尾天皇"],"1469":[[],"聖安女王",0,"後西天皇"],"1501":[[],"櫛笥賀子",0,"東山天皇"],"1533":[[],"清水谷石子",0,"中御門天皇"],"1565":[[],"大江磐代",