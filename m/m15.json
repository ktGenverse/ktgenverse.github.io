i_08.html#:~:text=%E5%BE%A1%E7%9C%9E%E6%B4%A5%E6%97%A5%E5%AD%90%E8%A8%B6%E6%83%A0%E5%BF%97%E6%B3%A5%E5%91%BD%E8%87%AA"]],"懿徳天皇",1,""],"271":[[],"阿居乃王",0,""],"303":[[[1,"日本書紀 巻第十七 継体天皇","次、茨田連小望女或曰妹曰關媛、生三女、長曰茨田大娘皇女、仲曰白坂活日姬皇女、少曰小野稚郎皇女更名長石姬。","https://seisaku.bz/nihonshoki/shoki_17.html#:~:text=%E5%B0%91%E6%9B%B0%E5%B0%8F%E9%87%8E%E7%A8%9A%E9%83%8E%E7%9A%87%E5%A5%B3%E6%9B%B4%E5%90%8D%E9%95%B7%E7%9F%B3%E5%A7%AC"]],"小野稚娘皇女",0,"継体天皇"],"335":[[[1,"日本書紀 巻第十九 欽明天皇","是生二男一女、長曰箭田珠勝大兄皇子、仲曰譯語田渟中倉太珠敷尊、少曰笠縫皇女。","https://seisaku.bz/nihonshoki/shoki_19.html#:~:text=%E4%BB%B2%E6%9B%B0%E8%AD%AF%E8%AA%9E%E7%94%B0%E6%B8%9F%E4%B8%AD%E5%80%89%E5%A4%AA%E7%8F%A0%E6%95%B7%E5%B0%8A"]],"箭田珠勝大兄皇子",0,"欽明天皇"],"367":[[[1,"日本書紀 巻第二十 敏達天皇","次采女伊勢大鹿首小熊女曰菟名子夫人、生太姬皇女更名、櫻井皇女與糠手姬皇女更名、田村皇女。","https://seisaku.bz/nihonshoki/shoki_20.html#:~:text=%E5%A5%B3%E4%BC%8A%E5%8B%A2%E5%A4%A7%E9%B9%BF%E9%A6%96%E5%B0%8F%E7%86%8A%E5%A5%B3%E6%9B%B0%E8%8F%9F%E5%90%8D%E5%AD%90%E5%A4%AB%E4%BA%BA"],[1,"古事記 下巻 敏達天皇","又娶伊勢大鹿首之女・小熊子郎女、生御子、布斗比賣命、次寶王・亦名糠代比賣王。二柱。","https://seisaku.bz/kojiki/kojiki_17.html#:~:text=%E5%8F%88%E5%A8%B6%E4%BC%8A%E5%8B%A2%E5%A4%A7%E9%B9%BF%E9%A6%96%E4%B9%8B%E5%A5%B3"]],"菟名子夫人",0,"敏達天皇"],"399":[[],"日置王",0,"用明天皇"],"431":[[],"山辺皇女",1,"天智天皇"],"463":[[[2,"続日本紀 巻第六 元正天皇","勅以三品吉備内親王男女。皆入皇孫之例焉。","https://zh.wikisource.org/wiki/續日本紀/卷第六#:~:text=%E5%8B%85%E4%BB%A5%E4%B8%89%E5%93%81%E5%90%89%E5%82%99%E5%86%85%E8%A6%AA%E7%8E%8B%E7%94%B7%E5%A5%B3"]],"長屋王",1,"天武天皇"],"495":[[],"船王",0,"天武天皇"],"527":[[],"兄彦命",0,"景行天皇"],"559":[[],"大宅内親王",0,"桓武天皇"],"591":[[],"惟良氏女",0,"嵯峨天皇"],"623":[[],"源融",0,"嵯峨天皇"],"655":[[],"柔子内親王",0,"仁明天皇"],"687":[[],"藤原穏子",0,"醍醐天皇"],"719":[[],"源経基",0,"清和天皇"],"751":[[],"源為明",0,"醍醐天皇"],"783":[[],"円融天皇",1,""],"815":[[],"源師房",0,"村上天皇"],"847":[[],"藤原歓子",0,"後冷泉天皇"],"879":[[],"藤原苡子",0,"堀河天皇"],"911":[[],"覚性法親王",0,"鳥羽天皇"],"943":[[],"伊岐致遠女",0,"二条天皇"],"975":[[],"順徳天皇",1,""],"1007":[[],"覚子内親王",0,"土御門天皇"],"1039":[[],"二条局",0,"後嵯峨天皇"],"1071":[[],"宗尊親王",0,"後嵯峨天皇"],"1103":[[],"姈子内親王",0,"後深草天皇"],"1135":[[],"奨子内親王",0,"後