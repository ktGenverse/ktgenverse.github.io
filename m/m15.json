{"15":[[[1,"日本書紀 巻第四 孝霊天皇","妃倭國香媛亦名絚某姉、生倭迹々日百襲姬命・彥五十狹芹彥命亦名吉備津彥命・倭迹々稚屋姬命。","https://seisaku.bz/nihonshoki/shoki_04.html#:~:text=%E5%BD%A5%E4%BA%94%E5%8D%81%E7%8B%B9%E8%8A%B9%E5%BD%A5%E5%91%BD%E4%BA%A6%E5%90%8D%E5%90%89%E5%82%99%E6%B4%A5%E5%BD%A5%E5%91%BD"],[1,"古事記 中巻 孝霊天皇","又娶意富夜麻登玖邇阿禮比賣命、生御子、夜麻登登母母曾毘賣命、次日子刺肩別命、次比古伊佐勢理毘古命・亦名大吉備津日子命、次倭飛羽矢若屋比賣。四柱。","https://seisaku.bz/kojiki/kojiki_08.html#:~:text=%E5%8F%88%E5%A8%B6%E6%84%8F%E5%AF%8C%E5%A4%9C%E9%BA%BB%E7%99%BB%E7%8E%96%E9%82%87%E9%98%BF%E7%A6%AE%E6%AF%94%E8%B3%A3%E5%91%BD"]],"倭国香媛",0,"孝霊天皇"],"47":[[[1,"日本書紀 巻第五 崇神天皇","二月辛亥朔丙寅、立御間城姬爲皇后。先是、后生活目入彥五十狹茅天皇・彥五十狹茅命・國方姬命・千々衝倭姬命・倭彥命・五十日鶴彥命。","https://seisaku.bz/nihonshoki/shoki_05.html#:~:text=%E5%90%8E%E7%94%9F%E6%B4%BB%E7%9B%AE%E5%85%A5%E5%BD%A5%E4%BA%94%E5%8D%81%E7%8B%B9%E8%8C%85%E5%A4%A9%E7%9A%87"]],"国方姫命",0,"崇神天皇"],"79":[[[1,"日本書紀 巻第六 垂仁天皇","皇后日葉酢媛命、生三男二女、第一曰五十瓊敷入彥命、第二曰大足彥尊、第三曰大中姬命、第四曰倭姬命、第五曰稚城瓊入彥命。","https://seisaku.bz/nihonshoki/shoki_06.html#:~:text=%E7%AC%AC%E4%B8%80%E6%9B%B0%E4%BA%94%E5%8D%81%E7%93%8A%E6%95%B7%E5%85%A5%E5%BD%A5%E5%91%BD"]],"稚城瓊入彦命",0,"垂仁天皇"],"111":[[[1,"日本書紀 巻第七 景行天皇","一書云、皇后生三男。其第三曰稚倭根子皇子。","https://seisaku.bz/nihonshoki/shoki_07.html#:~:text=%E5%85%B6%E7%AC%AC%E4%B8%89%E6%9B%B0%E7%A8%9A%E5%80%AD%E6%A0%B9%E5%AD%90%E7%9A%87%E5%AD%90"],[1,"日本書紀 巻第七 景行天皇","第一曰稚足彥天皇、第二曰五百城入彥皇子、第三曰忍之別皇子、第四曰稚倭根子皇子、第五曰大酢別皇子、第六曰渟熨斗皇女、","https://seisaku.bz/nihonshoki/shoki_07.html#:~:text=%E7%AC%AC%E4%BA%8C%E6%9B%B0%E4%BA%94%E7%99%BE%E5%9F%8E%E5%85%A5%E5%BD%A5%E7%9A%87%E5%AD%90"],[1,"古事記 中巻 孝元天皇","此天皇、娶穗積臣等之祖・內色許男命色許二字以音、下效此妹・內色許賣命、生御子、大毘古命、次少名日子建猪心命、次若倭根子日子大毘毘命。三柱。","https://seisaku.bz/kojiki/kojiki_08.html#:~:text=%E6%AC%A1%E8%8B%A5%E5%80%AD%E6%A0%B9%E5%AD%90%E6%97%A5%E5%AD%90%E5%A4%A7%E6%AF%98%E6%AF%98%E5%91%BD"]],"稚倭根子皇子",0,"景行天皇"],"143":[[[1,"日本書紀 巻第八 仲哀天皇","次娶來熊田造祖大酒主之女弟媛、生譽屋別皇子。","https://seisaku.bz/nihonshoki/shoki_08.html#:~:text=%E6%AC%A1%E5%A8%B6%E4%BE%86%E7%86%8A%E7%94%B0%E9%80%A0%E7%A5%96%E5%A4%A7%E9%85%92%E4%B8%BB%E4%B9%8B%E5%A5%B3%E5%BC%9F%E5%AA%9B"]],"誉屋別皇子",0,