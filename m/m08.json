{"8":[[[1,"日本書紀 巻第四 安寧天皇","一云、生三皇子、第一曰常津彥某兄、第二曰大日本彥耜友天皇、第三曰磯城津彥命。","https://seisaku.bz/nihonshoki/shoki_04.html#:~:text=%E7%AC%AC%E4%BA%8C%E6%9B%B0%E5%A4%A7%E6%97%A5%E6%9C%AC%E5%BD%A5%E8%80%9C%E5%8F%8B%E5%A4%A9%E7%9A%87"],[1,"古事記 中巻 綏靖天皇","此天皇、娶師木縣主之祖・河俣毘賣、生御子、師木津日子玉手見命。","https://seisaku.bz/kojiki/kojiki_08.html#:~:text=%E5%B8%AB%E6%9C%A8%E6%B4%A5%E6%97%A5%E5%AD%90%E7%8E%89%E6%89%8B%E8%A6%8B%E5%91%BD"]],"磯城津彦命",0,"安寧天皇"],"40":[[[1,"古事記 中巻 開化天皇","又娶庶母・伊迦賀色許賣命、生御子、御眞木入日子印惠命印惠二字以音、次御眞津比賣命。二柱。","https://seisaku.bz/kojiki/kojiki_08.html#:~:text=%E5%BE%A1%E7%9C%9E%E6%9C%A8%E5%85%A5%E6%97%A5%E5%AD%90%E5%8D%B0%E6%83%A0%E5%91%BD"],[1,"古事記 中巻 崇神天皇","又娶大毘古命之女・御眞津比賣命、生御子、伊玖米入日子伊沙知命伊玖米伊沙知六字以音、次伊邪能眞若命自伊至能以音、次國片比賣命、次千千都久和此三字以音比賣命、次伊賀比賣命、次倭日子命。六柱。","https://seisaku.bz/kojiki/kojiki_09.html#:~:text=%E4%BC%8A%E7%8E%96%E7%B1%B3%E5%85%A5%E6%97%A5%E5%AD%90%E4%BC%8A%E6%B2%99%E7%9F%A5%E5%91%BD%E4%BC%8A%E7%8E%96%E7%B1%B3%E4%BC%8A"]],"御真津比売命",0,"開化天皇"],"72":[[],"円目王",0,"垂仁天皇"],"104":[[[1,"日本書紀 巻第七 成務天皇","母皇后曰八坂入姬命、八坂入彥皇子之女也。","https://seisaku.bz/nihonshoki/shoki_07.html#:~:text=%E6%AF%8D%E7%9A%87%E5%90%8E%E6%9B%B0%E5%85%AB%E5%9D%82%E5%85%A5%E5%A7%AC%E5%91%BD"],[1,"古事記 中巻 景行天皇","又娶八尺入日子命之女・八坂之入日賣命、生御子、若帶日子命、次五百木之入日子命、次押別命、次五百木之入日賣命。","https://seisaku.bz/kojiki/kojiki_11.html#:~:text=%E5%8F%88%E5%A8%B6%E5%85%AB%E5%B0%BA%E5%85%A5%E6%97%A5%E5%AD%90%E5%91%BD%E4%B9%8B%E5%A5%B3"]],"八坂入媛命",0,"景行天皇"],"136":[[],"河俣稲依毘売",0,""],"168":[[[1,"古事記 中巻 応神天皇","此天皇、娶品陀眞若王品陀二字以音之女三柱女王、一名高木之入日賣命、次中日賣命、次弟日賣命。","https://seisaku.bz/kojiki/kojiki_13.html#:~:text=%E4%B8%80%E5%90%8D%E9%AB%98%E6%9C%A8%E4%B9%8B%E5%85%A5%E6%97%A5%E8%B3%A3%E5%91%BD"]],"品陀真若王",0,"景行天皇"],"200":[[[1,"日本書紀 巻第十二 反正天皇","立大宅臣祖木事之女津野媛、爲皇夫人、生香火姬皇女・圓皇女。","https://seisaku.bz/nihonshoki/shoki_12.html#:~:text=%E7%AB%8B%E5%A4%A7%E5%AE%85%E8%87%A3%E7%A5%96%E6%9C%A8%E4%BA%8B%E4%B9%8B%E5%A5%B3%E6%B4%A5%E9%87%8E%E5%AA%9B"]],"和珥津野媛",0,"反正天皇"],"232":[[[1,"日本書紀 巻第十五 仁賢天皇","次和珥臣日爪女糠君娘、生一女、是爲春日山田皇女。","https://seisaku.bz/nihonshoki/shoki_15.html#:~:text=%E6%AC%