{"31":[[[1,"日本書紀 巻第四 孝元天皇","后生二男一女、第一曰大彥命、第二曰稚日本根子彥大日々天皇、第三曰倭迹々姬命。","https://seisaku.bz/nihonshoki/shoki_04.html#:~:text=%E7%AC%AC%E4%BA%8C%E6%9B%B0%E7%A8%9A%E6%97%A5%E6%9C%AC%E6%A0%B9%E5%AD%90%E5%BD%A5%E5%A4%A7%E6%97%A5%E3%80%85%E5%A4%A9%E7%9A%87"],[1,"日本書紀 巻第六 垂仁天皇","母皇后曰御間城姬、大彥命之女也。","https://seisaku.bz/nihonshoki/shoki_06.html#:~:text=%E6%AF%8D%E7%9A%87%E5%90%8E%E6%9B%B0%E5%BE%A1%E9%96%93%E5%9F%8E%E5%A7%AC"],[1,"古事記 中巻 孝元天皇","此天皇、娶穗積臣等之祖・內色許男命色許二字以音、下效此妹・內色許賣命、生御子、大毘古命、次少名日子建猪心命、次若倭根子日子大毘毘命。三柱。","https://seisaku.bz/kojiki/kojiki_08.html#:~:text=%E6%AC%A1%E8%8B%A5%E5%80%AD%E6%A0%B9%E5%AD%90%E6%97%A5%E5%AD%90%E5%A4%A7%E6%AF%98%E6%AF%98%E5%91%BD"],[1,"古事記 中巻 崇神天皇","又娶大毘古命之女・御眞津比賣命、生御子、伊玖米入日子伊沙知命伊玖米伊沙知六字以音、次伊邪能眞若命自伊至能以音、次國片比賣命、次千千都久和此三字以音比賣命、次伊賀比賣命、次倭日子命。六柱。","https://seisaku.bz/kojiki/kojiki_09.html#:~:text=%E4%BC%8A%E7%8E%96%E7%B1%B3%E5%85%A5%E6%97%A5%E5%AD%90%E4%BC%8A%E6%B2%99%E7%9F%A5%E5%91%BD%E4%BC%8A%E7%8E%96%E7%B1%B3%E4%BC%8A"]],"大彦命",1,"孝元天皇"],"63":[[[1,"古事記 中巻 垂仁天皇","又娶大筒木垂根王之女・迦具夜比賣命、生御子、袁邪辨王。一柱。","https://seisaku.bz/kojiki/kojiki_10.html#:~:text=%E5%8F%88%E5%A8%B6%E5%A4%A7%E7%AD%92%E6%9C%A8%E5%9E%82%E6%A0%B9%E7%8E%8B%E4%B9%8B%E5%A5%B3"]],"迦具夜比売",0,"垂仁天皇"],"95":[[[1,"日本書紀 巻第七 景行天皇","次妃襲武媛、生國乳別皇子與國背別皇子一云宮道別皇子・豐戸別皇子、其兄國乳別皇子、是水沼別之始祖也、弟豐戸別皇子、是火國別之始祖也。","https://seisaku.bz/nihonshoki/shoki_07.html#:~:text=%E4%B9%B3%E5%88%A5%E7%9A%87%E5%AD%90%E8%88%87%E5%9C%8B%E8%83%8C%E5%88%A5%E7%9A%87%E5%AD%90%E4%B8%80%E4%BA%91%E5%AE%AE%E9%81%93%E5%88%A5%E7%9A%87"]],"豊戸別皇子",0,"景行天皇"],"127":[[],"山代之大筒木真若王",0,"開化天皇"],"159":[[[1,"日本書紀 巻第十 応神天皇","次妃和珥臣祖日觸使主之女宮主宅媛、生菟道稚郎子皇子・矢田皇女・雌鳥皇女。","https://seisaku.bz/nihonshoki/shoki_10.html#:~:text=%E6%AC%A1%E5%A6%83%E5%92%8C%E7%8F%A5%E8%87%A3%E7%A5%96%E6%97%A5%E8%A7%B8%E4%BD%BF%E4%B8%BB%E4%B9%8B%E5%A5%B3%E5%AE%AE%E4%B8%BB%E5%AE%85%E5%AA%9B"],[1,"古事記 中巻 応神天皇","又、娶丸邇之比布禮能意富美之女自比至美以音名宮主矢河枝比賣、生御子、宇遲能和紀郎子、次妹八田若郎女、次女鳥王。三柱。","https://seisaku.bz/kojiki/kojiki_13.html#:~:text=%E9%82%87%E4%B9%8B%E6%AF%94%E5%B8%83%E7%A6%AE%E8%83%BD%E6%84%8F%E5%AF%8C%E7%