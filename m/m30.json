{"30":[[[1,"日本書紀 巻第四 孝元天皇","七年春二月丙寅朔丁卯、立欝色謎命爲皇后。","https://seisaku.bz/nihonshoki/shoki_04.html#:~:text=%E4%B8%83%E5%B9%B4%E6%98%A5%E4%BA%8C%E6%9C%88%E4%B8%99%E5%AF%85%E6%9C%94%E4%B8%81%E5%8D%AF"],[1,"古事記 中巻 孝元天皇","此天皇、娶穗積臣等之祖・內色許男命色許二字以音、下效此妹・內色許賣命、生御子、大毘古命、次少名日子建猪心命、次若倭根子日子大毘毘命。三柱。","https://seisaku.bz/kojiki/kojiki_08.html#:~:text=%E6%AC%A1%E8%8B%A5%E5%80%AD%E6%A0%B9%E5%AD%90%E6%97%A5%E5%AD%90%E5%A4%A7%E6%AF%98%E6%AF%98%E5%91%BD"]],"欝色謎命",1,"孝元天皇"],"62":[[[1,"日本書紀 巻第六 垂仁天皇","次妃薊瓊入媛、生池速別命・稚淺津姬命。","https://seisaku.bz/nihonshoki/shoki_06.html#:~:text=%E6%AC%A1%E5%A6%83%E8%96%8A%E7%93%8A%E5%85%A5%E5%AA%9B"]],"稚浅津姫命",0,"垂仁天皇"],"94":[[[1,"日本書紀 巻第七 景行天皇","次妃襲武媛、生國乳別皇子與國背別皇子一云宮道別皇子・豐戸別皇子、其兄國乳別皇子、是水沼別之始祖也、弟豐戸別皇子、是火國別之始祖也。","https://seisaku.bz/nihonshoki/shoki_07.html#:~:text=%E4%B9%B3%E5%88%A5%E7%9A%87%E5%AD%90%E8%88%87%E5%9C%8B%E8%83%8C%E5%88%A5%E7%9A%87%E5%AD%90%E4%B8%80%E4%BA%91%E5%AE%AE%E9%81%93%E5%88%A5%E7%9A%87"]],"国背別皇子",0,"景行天皇"],"126":[[],"袁祁都比売命",0,"開化天皇"],"158":[[[1,"日本書紀 巻第十 応神天皇","次妃和珥臣祖日觸使主之女宮主宅媛、生菟道稚郎子皇子・矢田皇女・雌鳥皇女。","https://seisaku.bz/nihonshoki/shoki_10.html#:~:text=%E6%AC%A1%E5%A6%83%E5%92%8C%E7%8F%A5%E8%87%A3%E7%A5%96%E6%97%A5%E8%A7%B8%E4%BD%BF%E4%B8%BB%E4%B9%8B%E5%A5%B3%E5%AE%AE%E4%B8%BB%E5%AE%85%E5%AA%9B"],[1,"古事記 中巻 応神天皇","又、娶丸邇之比布禮能意富美之女自比至美以音名宮主矢河枝比賣、生御子、宇遲能和紀郎子、次妹八田若郎女、次女鳥王。三柱。","https://seisaku.bz/kojiki/kojiki_13.html#:~:text=%E9%82%87%E4%B9%8B%E6%AF%94%E5%B8%83%E7%A6%AE%E8%83%BD%E6%84%8F%E5%AF%8C%E7%BE%8E%E4%B9%8B%E5%A5%B3%E8%87%AA%E6%AF%94%E8%87%B3%E7%BE%8E%E4%BB%A5"]],"菟道稚郎子",1,"応神天皇"],"190":[[[1,"日本書紀 巻第十 応神天皇","立仲姬爲皇后、后生荒田皇女・大鷦鷯天皇・根鳥皇子。","https://seisaku.bz/nihonshoki/shoki_10.html#:~:text=%E7%AB%8B%E4%BB%B2%E5%A7%AC%E7%88%B2%E7%9A%87%E5%90%8E"],[1,"日本書紀 巻第十 応神天皇","根鳥皇子、是大田君之始祖也。","https://seisaku.bz/nihonshoki/shoki_10.html#:~:text=%E6%98%AF%E5%A4%A7%E7%94%B0%E5%90%9B%E4%B9%8B%E5%A7%8B%E7%A5%96%E4%B9%9F"]],"根鳥皇子",0,"応神天皇"],"222":[[[1,"日本書紀 巻第十四 雄略天皇","次有吉備上道臣女稚媛一本云、吉備窪屋臣女生二男、長曰磐城皇子、少曰星川稚宮皇子。","https://seisaku.bz/nihonshoki/shoki_14.html#:~: